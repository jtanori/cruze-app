{
  "name": "@cruce/root",
  "version": "0.1.0",
  "private": true,
  "description": "Cruce monorepo root",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:web": "pnpm --filter cruce-web dev",
    "build:web": "pnpm --filter cruce-web build"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@9.0.0"
}
