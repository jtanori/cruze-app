# Copy to .env.local for local development. Never commit real values.
# Client map rendering (public by design — restrict by URL in Mapbox dashboard).
NEXT_PUBLIC_MAPBOX_TOKEN=
# Server geocoding/directions proxy (/api/places, /api/reverse, /api/directions).
# Falls back to NEXT_PUBLIC_MAPBOX_TOKEN when unset; set a secret-scoped key here.
MAPBOX_TOKEN=
